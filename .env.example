# Copy to .env for local overrides. Never commit real secrets.

# Server
PORT=3000
NODE_ENV=development

# Postgres connection. When unset in development, the server uses
# file-backed PGlite at ./data/pglite so data survives restarts without Docker.
# Production requires a real postgres:// or postgresql:// URL.
DATABASE_URL=postgres://playground:playground@localhost:5432/playground

# Required in production. Use a long random string (32+ bytes).
SESSION_SECRET=replace-with-a-long-random-string

# Set true behind HTTPS so session cookies are Secure.
COOKIE_SECURE=false

# Required in production. Absolute http(s) origin of the app, with no path.
PUBLIC_BASE_URL=http://localhost:3000

# Separate origin for freeform HTML games. Required in production.
# Development defaults to http://127.0.0.1:43921 when USERCONTENT_ORIGIN is unset.
# Production refuses to boot when this host equals PUBLIC_BASE_URL's host or
# shares its registrable domain. Use a different domain, such as
# https://playgroundusercontent.com.
USERCONTENT_ORIGIN=http://127.0.0.1:43921
USERCONTENT_PORT=43921
# Set true only to allow a same-host or same-site sandbox, such as a subdomain.
ALLOW_SAME_SITE_USERCONTENT=false

# X handle for twitter:site, with or without @. Omit to leave the tag out.
X_SITE_HANDLE=

# Seed the example games when the games table is empty.
# Defaults to true in development and false in production.
SEED_ON_EMPTY=true

# Anonymous socket cap per IP for a shared block world.
WORLD_GUEST_CAP=8

# Rate limits per IP per minute.
RATE_LIMIT_MAX=90
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20

# scrypt CPU/memory cost (power of two). 16384 is the default.
PASSWORD_SCRYPT_N=16384

# AI provider: auto | anthropic | gemini | openai | xai
# auto picks the first configured key: Anthropic, then Gemini, then xAI, then OpenAI.
# With no key, POST /api/ai/generate stays in template mode.
AI_PROVIDER=anthropic
# Per-path overrides. All three default to Anthropic claude-sonnet-5-5.
AI_PROVIDER_SPEC=anthropic
AI_PROVIDER_FREEFORM=anthropic
AI_PROVIDER_SAFETY=anthropic
# Comma-separated fallbacks used only on 429 and 5xx, never on 401 or 400.
# Unset means Gemini. An empty value disables fallback (the bakeoff does this).
AI_FALLBACKS=gemini

# Google AI Studio / Gemini. Default model is configurable.
GEMINI_API_KEY=
# Default is the faster gemini-3.5-flash. Set gemini-3.8-flash when you want that model.
GEMINI_MODEL=gemini-3.5-flash

# OpenAI Responses API. Reasoning models reject a non-default temperature, so it is omitted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Anthropic Messages API. Tool use carries the JSON schema. Temperature is omitted.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# off sends thinking {type:between_tools}. This model rejects {type:disabled}. on leaves thinking enabled.
ANTHROPIC_THINKING=off
# Gemini 3 thinks unless this is off or default. low is the usual setting.
GEMINI_THINKING_LEVEL=low
# Spec and template HTTP timeout in milliseconds. Default 60000. Freeform does not use this as its cap.
AI_TIMEOUT_MS=60000
# Freeform sandbox timeout. Unset uses 180000, and a 25s stall aborts if tokens stop arriving.
# AI_FREEFORM_TIMEOUT_MS=180000
# Delay before the single retry of a 500 or 503. Tests set this to 1.
AI_RETRY_DELAY_MS=2000
# all listens on PORT and USERCONTENT_PORT. app or usercontent is one listener on PORT.
SERVER_ROLE=all

# Optional. Raises the GitHub API rate limit for Bring your game. Imports work without it.
GITHUB_TOKEN=

# Comma-separated moderator emails. These accounts can open /admin.
ADMIN_EMAILS=
# AI generation attempts per account, per guest browser, per guest IP, and for everyone, each UTC day.
AI_DAILY_LIMIT_PER_USER=20
AI_DAILY_LIMIT_PER_GUEST=10
AI_DAILY_LIMIT_GLOBAL=200
# Published games per IP per minute.
PUBLISH_RATE_LIMIT_MAX=12
# Gemini safety check on publish. This spends free-tier quota. The local blocklist still runs.
# Unset: on in production, off in development. Set false to skip the model call.
SAFETY_MODEL_ON_PUBLISH=

# Sign in with X (OAuth 2.0 PKCE). Disabled when either value is empty.
# The adapter is stubbed until the token exchange is implemented.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# xAI stays on chat completions. OpenAI uses the Responses API above.
OPENAI_BASE_URL=https://api.openai.com/v1

# xAI Grok, via the OpenAI-compatible chat completions adapter.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3
