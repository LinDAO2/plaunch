# Copy to .env for local overrides. Never commit real secrets.

# Server
PORT=3000
NODE_ENV=development

# Postgres connection. When unset in development, the server uses
# file-backed PGlite at ./data/pglite so data survives restarts without Docker.
# Production requires a real postgres:// or postgresql:// URL.
DATABASE_URL=postgres://playground:playground@localhost:5432/playground

# Required in production. Use a long random string (32+ bytes).
SESSION_SECRET=replace-with-a-long-random-string

# Set true behind HTTPS so session cookies are Secure.
COOKIE_SECURE=false

# Required in production. Absolute http(s) origin of the app, with no path.
PUBLIC_BASE_URL=http://localhost:3000

# Separate origin for freeform HTML games. Required in production.
# Development defaults to http://127.0.0.1:43921 when USERCONTENT_ORIGIN is unset.
# Production refuses to boot when this host equals PUBLIC_BASE_URL's host or
# shares its registrable domain. Use a different domain, such as
# https://playgroundusercontent.com.
USERCONTENT_ORIGIN=http://127.0.0.1:43921
USERCONTENT_PORT=43921
# Set true only to allow a same-host or same-site sandbox, such as a subdomain.
ALLOW_SAME_SITE_USERCONTENT=false

# X handle for twitter:site, with or without @. Omit to leave the tag out.
X_SITE_HANDLE=

# Seed the example games when the games table is empty.
# Defaults to true in development and false in production.
SEED_ON_EMPTY=true

# Anonymous socket cap per IP for a shared block world.
WORLD_GUEST_CAP=8

# Rate limits per IP per minute.
RATE_LIMIT_MAX=90
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20

# scrypt CPU/memory cost (power of two). 16384 is the default.
PASSWORD_SCRYPT_N=16384

# AI provider: auto | gemini | openai | xai
# auto picks the first configured key: Gemini, then xAI, then OpenAI.
# With no key, POST /api/ai/generate stays in template mode.
AI_PROVIDER=auto

# Google AI Studio / Gemini. Default model is configurable.
GEMINI_API_KEY=
# Default is the faster gemini-3.5-flash. Set gemini-3.8-flash when you want that model.
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3 thinks unless this is off or default. low is the usual setting.
GEMINI_THINKING_LEVEL=low
# Provider HTTP timeout in milliseconds. Live Gemini 3.8 calls sometimes need the full minute.
AI_TIMEOUT_MS=60000
# Delay before the single retry of a 500 or 503. Tests set this to 1.
AI_RETRY_DELAY_MS=2000
# all listens on PORT and USERCONTENT_PORT. app or usercontent is one listener on PORT.
SERVER_ROLE=all

# Comma-separated moderator emails. These accounts can open /admin.
ADMIN_EMAILS=
# AI generation attempts per account, and for everyone, each UTC day.
AI_DAILY_LIMIT_PER_USER=20
AI_DAILY_LIMIT_GLOBAL=200
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible chat completions API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# xAI Grok, via the OpenAI-compatible adapter.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3
